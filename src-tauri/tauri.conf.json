{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "todo-list",
  "version": "0.1.0",
  "identifier": "com.qw22231.todolist",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "我的任務",
        "width": 300,
        "height": 600,
        "minWidth": 300,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
